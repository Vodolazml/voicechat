# Local development only. For a real server run deploy/install.sh, which generates secrets.
VOICECHAT_ENVIRONMENT=development
VOICECHAT_SECRET_KEY=
VOICECHAT_BOOTSTRAP_PASSWORD=
VOICECHAT_DATABASE_URL=sqlite:///./voicechat.db
VOICECHAT_ALLOWED_HOSTS=["127.0.0.1","localhost"]
VOICECHAT_CORS_ORIGINS=[]
VOICECHAT_DOWNLOADS_DIR=downloads
VOICECHAT_LIVEKIT_URL=ws://127.0.0.1:7880
VOICECHAT_LIVEKIT_INTERNAL_URL=http://127.0.0.1:7880
VOICECHAT_LIVEKIT_API_KEY=
VOICECHAT_LIVEKIT_API_SECRET=
