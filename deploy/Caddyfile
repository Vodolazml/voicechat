# chat.<domain>: API and client downloads. rtc.<domain>: LiveKit signalling (wss://).
# Caddy obtains and renews Let's Encrypt certificates for both names automatically.
{
    email {$VOICECHAT_ACME_EMAIL}
}

(security_headers) {
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Permissions-Policy "camera=(), microphone=(), display-capture=()"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }
}

chat.{$VOICECHAT_DOMAIN} {
    import security_headers
    # Installers straight from disk (sendfile, ranges for resumed and parallel downloads): big downloads
    # no longer pass through the API's single Python process that also carries the live chat events.
    handle_path /downloads/* {
        root * /srv/downloads
        file_server
    }
    handle {
        encode zstd gzip
        reverse_proxy 127.0.0.1:8765
    }
}

rtc.{$VOICECHAT_DOMAIN} {
    import security_headers
    reverse_proxy 127.0.0.1:7880
}
